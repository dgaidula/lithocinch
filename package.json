{
  "name": "lithocinch",
  "version": "3.0.1",
  "description": "Fast, batch image optimizer built on sharp + svgo. Caps dimensions, normalizes color to sRGB, compresses JPEG/PNG/GIF/WebP/AVIF/TIFF and SVG. Usable as a CLI, a library, or an AWS Lambda.",
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./transform": "./src/transform-api.js",
    "./server": "./src/server.js",
    "./lambda": "./lambda/handler.js",
    "./lambda/transform": "./lambda/transform.js"
  },
  "main": "./src/index.js",
  "bin": {
    "lithocinch": "src/cli.js",
    "litho": "src/cli.js"
  },
  "files": [
    "src",
    "lambda",
    "docs",
    "README.md",
    "NOTES.md",
    "RESEARCH.md",
    "SPEC.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/cli.js",
    "optimize": "node src/cli.js",
    "serve": "node src/cli.js serve",
    "test": "node --test",
    "lint": "node --check src/cli.js"
  },
  "keywords": [
    "image",
    "optimize",
    "optimise",
    "sharp",
    "svgo",
    "jpeg",
    "mozjpeg",
    "png",
    "webp",
    "avif",
    "svg",
    "resize",
    "srgb",
    "cmyk",
    "batch",
    "lambda",
    "cli"
  ],
  "author": "Danniel T. Gaidula <dan@iceboxind.com>",
  "license": "Apache-2.0",
  "dependencies": {
    "cli-progress": "^3.12.0",
    "commander": "^15.0.0",
    "picocolors": "^1.1.1",
    "sharp": "^0.35.2",
    "svgo": "^4.0.1",
    "tinyglobby": "^0.2.17"
  }
}
